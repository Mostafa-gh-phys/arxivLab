{
  "appId": "org.arxivlab.workstation",
  "appName": "arXivLab",
  "webDir": "dist",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#f5f5f7"
  },
  "plugins": {
    "CapacitorHttp": {
